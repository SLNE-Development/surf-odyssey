# Copy to .env to override the defaults of the development stack (compose.yaml)

POSTGRES_DATABASE=surf
POSTGRES_USERNAME=surf
POSTGRES_PASSWORD=surf
POSTGRES_PORT=5432

RABBITMQ_USERNAME=surf
RABBITMQ_PASSWORD=surf
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

VALKEY_PASSWORD=surf
VALKEY_PORT=6379

# The S3 keys have to match docker/seaweedfs/s3.json, SeaweedFS does not read them from the environment
S3_ACCESS_KEY=odyssey
S3_SECRET_KEY=odyssey-dev-secret
# Host and port the Minecraft client downloads the resource pack from
S3_PUBLIC_HOST=localhost:8333
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ADMIN_PORT=23646
SEAWEEDFS_ADMIN_PASSWORD=surf

PROXY_PORT=25565
PROXY_MEMORY=512M
PAPER_MEMORY=2G
VELOCITY_FORWARDING_SECRET=surf-odyssey-development
